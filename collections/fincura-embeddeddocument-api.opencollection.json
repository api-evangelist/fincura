{
  "opencollection": "1.0.0",
  "info": {
    "name": "Automated Spreading and Analysis Api-Key EmbeddedDocument API",
    "version": "1.3.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "EmbeddedDocument",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "retrieveEmbeddedWorkflow",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/embedded-workflow/:uuid",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "createEmbeddedWorkflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/embedded-workflow",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns a URL to an HTML webapp to complete document parsing pipeline flow"
        }
      ]
    }
  ],
  "bundled": true
}