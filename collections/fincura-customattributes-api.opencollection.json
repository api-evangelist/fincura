          "info": {
            "name": "List CustomAttributeDefinitions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/custom-attribute-definition",
            "params": [
              {
                "name": "limit",
                "value": "",
