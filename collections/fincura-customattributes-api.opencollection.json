              {
                "name": "uuid",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a CustomAttributeDefinition"
        },
        {
          "info": {
            "name": "Delete a CustomAttributeDefinition",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1/custom-attribute-definition/:uuid",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a CustomAttributeDefinition."
        }
      ]
    }
  ],
  "bundled": true
}