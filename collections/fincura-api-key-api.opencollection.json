{
  "opencollection": "1.0.0",
  "info": {
    "name": "Automated Spreading and Analysis Api-Key API",
    "version": "1.3.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Api-Key",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Refresh Api Key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/api-key/refresh",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Extend the life of the current authorized token by exchanging it for a new one"
        }
      ]
    }
  ],
  "bundled": true
}